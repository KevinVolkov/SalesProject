Description: This module provides an interface for the admin to add new items to the inventory. 
- Allows admins to input item details such as name, description, price, stock and upload (optionally) an image.
- Allows the creation (by admin) of new products in the database.
-->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin's Add Item</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('../partials/header') %>
    <div class="container">



<h1>Add New Item</h1>
<form action="/admin/items/add" method="POST">
    <label for="name">Item Name:</label>
    <input type="text" name="name" required>
    <label for="price">Price:</label>
    <input type="number" name="price" min="1" step="any" required> <!-- min and step to allow fractions  -->
    <label for="description">Description:</label>
    <textarea name="description"></textarea>

    <label for="stock">Stock:</label>
    <input type="number" name="stock" min="1" required>
    <!-- <textarea name="stock" required></textarea>  Kevin: do not allow non-numbers crashes!!!-->
    
    <label for="itemImage">Upload Image:</label>
    <input type="file" name="itemImage">
  

    <button type="submit">Add Item</button>
</form>


</div>
</body>
</html>
