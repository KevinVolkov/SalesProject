Description: 'Checkout View' to finalize user's order and initiate the purchase.
- Collects  details for completing the purchase: address and payment info.
- Provides  a summary of the purchased items and the total cost.
-->

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0" />
		<title>Checkout</title>
		<link
			rel="stylesheet"
			href="/css/styles.css" />
	</head>
	<body>
		<%- include('partials/header') %>

		<div class="container">
			<h1>Checkout</h1>
			<div class="info-container">
				<form
					action="/order/checkout"
					method="POST">
					<h2 class="customer-info">Customer Information</h2>
					<label for="name">Name</label>
					<input
						type="text"
						id="name"
						name="name"
						required />

					<label for="email">Email</label>
					<input
						type="email"
						id="email"
						name="email"
						required />

						


					<label for="address">Shipping Address</label>
					<input
						type="text"
						id="address"
						name="address"
						required />


					<!-- Start Kevin inserted Shipping Method on 12/07/24  -->

					<label for="shippingMethod">Choose Shipping Method:</label>
					<select id="shippingMethod" name="shippingMethod" required>
						<option value="FedExSameDay">Fedex Same-Day</option>
						<option value="FedExOvernight">Fedex Overnight</option>
						<option value="FedExGround">Fedex Ground</option>
						<option value="USPSPriorityMailExpress">USPS Priority Mail Express</option>
						<option value="USPSPriorityMail">USPS Priority Mail</option>
						<option value="USPSRetailGround">USPS Retail Ground</option>
					</select>


				<!-- Start Kevin inserted Shipping Method on 12/07/24  -->

					<h2 class="pay-info">Payment Information</h2>
					<label for="creditCard">Credit Card Number</label>
					<input
						type="text"
						id="creditCard"
						name="creditCard"
						required />

					<input
						type="submit"
						value="Complete Purchase" />
				</form>
			</div>
		</div>
	</body>
</html>
